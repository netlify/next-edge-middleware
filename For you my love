<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Dhruba to Ishita 💖</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background: linear-gradient(to bottom right, #ffe6f0, #e6f7ff);
      font-family: 'Segoe UI', sans-serif;
      color: #333;
      text-align: center;
      overflow: hidden;
    }
    h1 {
      margin-top: 40px;
      font-size: 2em;
      color: #ff3399;
    }
    p, .shayari {
      font-size: 1.2em;
      margin: 10px 20px;
    }
    .hearts {
      position: fixed;
      width: 100%;
      height: 100%;
      z-index: -1;
      top: 0;
      left: 0;
      pointer-events: none;
      overflow: hidden;
    }
    .heart {
      position: absolute;
      width: 20px;
      height: 20px;
      background-color: white;
      border-radius: 50%;
      opacity: 0.6;
      animation: fall 5s infinite;
    }
    @keyframes fall {
      0% { transform: translateY(-10%); }
      100% { transform: translateY(100vh); }
    }
    .slide {
      display: none;
      animation: fadeIn 1s ease;
    }
    .slide.active {
      display: block;
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    .buttons {
      margin-top: 20px;
    }
    .btn {
      display: inline-block;
      padding: 10px 20px;
      background-color: #ff66b3;
      color: white;
      border: none;
      border-radius: 25px;
      font-weight: bold;
      margin: 0 10px;
      cursor: pointer;
      box-shadow: 0 4px 8px rgba(0,0,0,0.2);
    }
    .btn:hover {
      background-color: #ff3399;
    }
    iframe {
      margin-top: 20px;
      border: none;
      width: 90%;
      height: 120px;
    }
  </style>
</head>
<body>

  <div class="hearts"></div>

  <div class="slide active">
    <h1>I love you so much, Ishita — my Cupcake 🎂</h1>
    <div class="shayari">
      <p>💌 Tere bina adhura hoon main,</p>
      <p>Har pal sirf tera intezaar karta hoon main 💖</p>
    </div>
  </div>

  <div class="slide">
    <h1>Teri muskurahat, Ishita, meri jaan hai 🌹</h1>
    <div class="shayari">
      <p>Tujhse hi toh meri pehchaan hai ✨</p>
      <p>Teri har ek baat dil ko chhoo jaati hai 💞</p>
    </div>
  </div>

  <div class="slide">
    <h1>Forever yours, Ishita – Yours truly, Dhruba 💍</h1>
    <div class="shayari">
      <p>Tu hi meri khushi hai, tu hi mera pyaar,</p>
      <p>Tere bina suuna sa lagta har ik sansaar 🌌</p>
    </div>
  </div>

  <div class="buttons">
    <button class="btn" onclick="prevSlide()">⬅️ Previous</button>
    <button class="btn" onclick="nextSlide()">Next ➡️</button>
  </div>

  <!-- YouTube CO2 song embed -->
  <iframe src="https://www.youtube.com/embed/rrCYMsV7A-c?autoplay=1&loop=1&playlist=rrCYMsV7A-c" allow="autoplay" allowfullscreen></iframe>

  <script>
    // Heart animation
    const heartsContainer = document.querySelector('.hearts');
    for (let i = 0; i < 50; i++) {
      const heart = document.createElement('div');
      heart.classList.add('heart');
      heart.style.left = Math.random() * 100 + "vw";
      heart.style.animationDuration = (2 + Math.random() * 3) + "s";
      heart.style.backgroundColor = Math.random() > 0.5 ? "white" : "#b3e0ff";
      heartsContainer.appendChild(heart);
    }

    // Slide logic
    let currentSlide = 0;
    const slides = document.querySelectorAll('.slide');

    function showSlide(index) {
      slides.forEach((slide, i) => {
        slide.classList.toggle('active', i === index);
      });
    }

    function nextSlide() {
      currentSlide = (currentSlide + 1) % slides.length;
      showSlide(currentSlide);
    }

    function prevSlide() {
      currentSlide = (currentSlide - 1 + slides.length) % slides.length;
      showSlide(currentSlide);
    }
  </script>

</body>
